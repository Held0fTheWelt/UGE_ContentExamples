    { "Name": "LyraGame", "Type": "Runtime", "LoadingPhase": "Default" },
    { "Name": "ShooterCoreRuntime", "Type": "Runtime", "LoadingPhase": "Default" }
  ],
  "Plugins": [
    { "Name": "GameFeatures", "Enabled": true },
    { "Name": "ModularGameplay", "Enabled": true },
    { "Name": "EnhancedInput", "Enabled": true },
    { "Name": "CommonUI", "Enabled": true },
    { "Name": "Core_Collection", "Enabled": true },
    { "Name": "GameFeature_InventorySystem", "Enabled": true },
    { "Name": "GameFeature_CosmeticsSystem", "Enabled": true },
    { "Name": "GameFeature_EquipmentSystem", "Enabled": true },
    { "Name": "GameFeature_FeedbackSystem", "Enabled": true }
  ]

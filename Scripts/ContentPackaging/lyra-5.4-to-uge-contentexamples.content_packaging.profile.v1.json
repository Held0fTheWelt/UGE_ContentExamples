	"composition_rebuild_rules": [
		{
			"rule_id": "editor_tooling_rebuild_contract",
			"match": {
				"classes": [
					"EditorUtilityBlueprint"
				]
			},
			"priority": 300,
			"target_architecture": "EditorTooling",
			"implementation_kind": "DiscardSourceEditorTooling",
			"suggested_owner": "TargetEditorTooling",
			"default_disposition": "discard",
			"depends_on_packs": [],
			"include_inferred_packs": false,
			"implementation_notes": "Source editor utility tooling is development-only Blutility content; discard by default unless the target project deliberately defines an equivalent editor utility."
		},
		{
			"rule_id": "frontend_map_rebuild_contract",
			"match": {
				"paths": [
					"/Game/System/FrontEnd/Maps/**",
					"/ShooterCore/System/FrontEnd/Maps/**"
				]
			},
			"priority": 260,
			"target_architecture": "MapAssembly",
			"implementation_kind": "RebuildMapFromVisualAssetPacks",
			"suggested_owner": "TargetMapAssembly",
			"depends_on_packs": [
				"LyraMapAssets",
				"LyraSharedVisualAssets",
				"LyraUIAssets"
			],
			"include_inferred_packs": true,
			"implementation_notes": "Rebuild frontend level composition from routed visual and UI packs; do not import the legacy World or MapBuildDataRegistry asset directly."
		},
		{
			"rule_id": "map_rebuild_contract",
			"match": {
				"classes": [
					"World",
					"MapBuildDataRegistry"
				]
			},
			"priority": 240,
			"target_architecture": "MapAssembly",
			"implementation_kind": "RebuildMapFromVisualAssetPacks",
			"suggested_owner": "TargetMapAssembly",
			"depends_on_packs": [
				"LyraMapAssets",
				"LyraSharedVisualAssets"
			],
			"include_inferred_packs": true,
			"implementation_notes": "Rebuild level/world composition from routed visual packs and target-native map assembly rules; do not import the legacy World or MapBuildDataRegistry asset directly."
		},
		{
			"rule_id": "ui_rebuild_contract",
			"match": {
				"classes": [
					"WidgetBlueprint",
					"CommonActivatableWidget",
					"CommonUserWidget"
				]
			},
			"priority": 230,
			"target_architecture": "UIComposition",
			"implementation_kind": "RebuildWidgetOrFrontendFlowInTargetUI",
			"suggested_owner": "TargetUI",
			"depends_on_packs": [
				"LyraSharedVisualAssets",
				"LyraUIAssets"
			],
			"include_inferred_packs": true,
			"implementation_notes": "Rebuild widget, screen, and frontend flow against the target UI framework while reusing routed textures, materials, fonts, and shared presentation assets."
		},
		{
			"rule_id": "frontend_flow_rebuild_contract",
			"match": {
				"paths": [
					"/Game/System/FrontEnd/**",
					"/ShooterCore/System/FrontEnd/**"
				]
			},
			"priority": 225,
			"target_architecture": "UIComposition",
			"implementation_kind": "RebuildWidgetOrFrontendFlowInTargetUI",
			"suggested_owner": "TargetUI",
			"depends_on_packs": [
				"LyraSharedVisualAssets",
				"LyraUIAssets"
			],
			"include_inferred_packs": true,
			"implementation_notes": "Rebuild frontend experience and flow assets against the target UI framework while preserving references to routed UI and shared presentation packs."
		},
		{
			"rule_id": "experience_rebuild_contract",
			"match": {
				"classes": [
					"LyraExperienceDefinition",
					"LyraExperienceActionSet",

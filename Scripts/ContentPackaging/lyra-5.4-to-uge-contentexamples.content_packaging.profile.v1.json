				"LyraSharedVisualAssets",
				"LyraSystemAssets",
				"LyraWeaponAssets"
			],
			"include_inferred_packs": true,
			"implementation_notes": "Rebuild blueprint, AI, input, gameplay ability, and team composition logic against the target gameplay architecture instead of copying legacy class-bound assets."
		}

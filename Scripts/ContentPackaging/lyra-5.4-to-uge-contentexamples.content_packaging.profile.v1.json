				"paths": [
					"/Game/PhysicsMaterials/**",
					"/ShooterCore/PhysicsMaterials/**",
					"/Game/Effects/MaterialFunctions/**",
					"/ShooterCore/Effects/MaterialFunctions/**",
					"/Game/Effects/Textures/**",
					"/ShooterCore/Effects/Textures/**",
					"/Game/Effects/Curves/**",
					"/ShooterCore/Effects/Curves/**",
					"/Game/Effects/Materials/PickUp/**",
					"/ShooterCore/Effects/Materials/PickUp/**",
					"/Game/Characters/Heroes/Mannequin/Textures/Shared/**",
					"/Game/Weapons/Generic/Textures/**",
					"/ShooterCore/Weapons/Generic/Textures/**",
					"/LyraExampleContent/Materials/Textures/**",
					"/LyraExampleContent/Materials/MF/**",
					"/LyraExampleContent/Materials/MPC_*",
					"/LyraExampleContent/MSPresets/**"
				]
			},
			"priority": 300,
			"min_referencing_packs": 1
		}

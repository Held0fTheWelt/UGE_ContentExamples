			"include_inferred_packs": true,
			"implementation_notes": "Recreate experience, pawn, input, and action-set wiring as target-native data that references the routed content packs instead of legacy Lyra gameplay classes."
		},
		{
			"rule_id": "animation_rebuild_contract",
